# Public site URL (used for Open Graph / link-preview absolute image URLs)
NEXT_PUBLIC_SITE_URL=https://themurphymethod.co

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Prefer a restricted key with Checkout Session permissions.
STRIPE_RESTRICTED_KEY=rk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PREGNANCY=price_...
STRIPE_PRICE_POSTPARTUM=price_...
STRIPE_PRICE_MOMS_ANY_PHASE=price_...

# Supabase
# Local dev: use the canonical names below. Copy values from the Vercel Supabase
# integration (Show secret), mapping integration → .env.local:
#   NEXT_PUBLIC_SUPABASE_SUPABASE_URL              → NEXT_PUBLIC_SUPABASE_URL
#   NEXT_PUBLIC_SUPABASE_SUPABASE_ANON_KEY         → NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
#   (or NEXT_PUBLIC_NEXT_PUBLIC_SUPABASE_..._KEY)
# Secret key is NOT in the integration snippet — get it from Supabase Dashboard → API.
# Ignore all NEXT_PUBLIC_SUPABASE_POSTGRES_* vars; this app does not use them.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# Resend
RESEND_API_KEY=re_...
FROM_EMAIL=hello@example.com
CONTACT_TO_EMAIL=erin@example.com
# Optional; falls back to CONTACT_TO_EMAIL.
PROGRAM_PURCHASE_TO_EMAIL=erin@example.com




